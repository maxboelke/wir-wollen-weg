# Copy to .env.local for local development: cp .env.example .env.local
# Names per docs/ops/deployment.md §4. Values below are local placeholders, NOT secrets.

# development (pnpm dev) · demo (docker/compose.demo.yml) · ci · staging · preview · beta · production
# preview = password-protected online preview on Vercel + Neon (PRD Q25, deployment.md §0.7).
# beta = closed friends beta with real data on Vercel + Neon (Gate G0, deployment.md §0.12):
# no Basic Auth, beta code at sign-up, real mails via SMTP, PWA/service worker.
# On Vercel an empty APP_ENV counts as preview and an empty APP_URL as https://<production domain>.
APP_ENV=development
APP_URL=http://localhost:3000

# Time zone that defines «today» for trips (countdown, phases, deadlines – R-072). IANA name,
# read at build time (inlined for the browser). Empty = Europe/Berlin.
APP_TIME_ZONE=

# Online preview only (APP_ENV=preview): HTTP Basic Auth password for every page and API route
# (user name: anything, e.g. "demo"); at least 10 characters. Missing = the preview stays closed.
PREVIEW_ACCESS_PASSWORD=

# Demo only (docker/compose.demo.yml): password of the demo database container
POSTGRES_PASSWORD=change-me-local-only

# PostgreSQL from docker/compose.dev.yml
DATABASE_URL=postgres://app:app@localhost:5432/wirwollenweg

# Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=

# Client IP for auth rate limits (R-005, docs/ops/deployment.md §0.1/§0.5/§5.2).
# The app must only be reachable through a proxy that OVERWRITES this header:
#   dev/ci/demo (Caddy in compose.demo.yml) + production (Caddy): x-forwarded-for
#   demo via Cloudflare tunnel: cf-connecting-ip (and DEMO_BIND_ADDRESS=127.0.0.1)
AUTH_IP_HEADER=x-forwarded-for
# Comma-separated IPs/CIDRs of proxies whose entries in the header are skipped (right to
# left). Empty = the rightmost entry is the client. Only for proxy chains, e.g. CDN → Caddy.
AUTH_TRUSTED_PROXIES=

# Demo only: host address for the published ports (proxy 3000, Mailpit 8025).
# 0.0.0.0 = LAN phone tests (trusted WLAN only), 127.0.0.1 = laptop only (café WLAN, tunnel)
DEMO_BIND_ADDRESS=0.0.0.0

# Mail transport: smtp (Mailpit locally, mail provider later) or inbox (online preview: mails are
# stored in the database and shown on /demo/postfach – never in production).
# Mailpit from docker/compose.dev.yml (web UI: http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=login@mail.example.org
MAIL_FROM_NAME_DE="Wir wollen weg"
MAIL_FROM_NAME_EN="When do we go?"
MAIL_REPLY_TO=hallo@example.org
MAILPIT_API_URL=http://localhost:8025

# Phone tests with `pnpm dev -H 0.0.0.0`: comma-separated LAN hosts, e.g. 192.168.178.20
DEV_ALLOWED_ORIGINS=

LOG_LEVEL=debug
RATE_LIMIT_ENABLED=true

# Optional online leak check for new passwords via Have I Been Pwned (k-anonymity API).
# "off" in the offline demo (no external services); decide before go-live.
PASSWORD_BREACH_CHECK=off
# Contact address shown on the help page (placeholder until go-live)
CONTACT_EMAIL=hallo@example.org
# Retention job (F-013/F-043): token for POST /api/internal/retention, called once a day by a
# timer. Empty = endpoint off (404). Generate: openssl rand -base64 32
RETENTION_TOKEN=
# Vercel Cron (online preview): Vercel calls GET /api/internal/retention with
# "Authorization: Bearer $CRON_SECRET" – accepted like RETENTION_TOKEN (min. 32 characters).
CRON_SECRET=

# Database connections per server instance (default 10; on Vercel 3). Neon (preview) also sets
# DATABASE_URL_UNPOOLED – migrations and the demo seed use it when present.
DATABASE_POOL_MAX=

# Personal travel details (F-054, deployment.md §0.11). Optional in development/ci/demo/preview:
# on by default there, the key is derived from BETTER_AUTH_SECRET (kid "demo"). staging/production:
# off by default; switching on needs an own key (start guard) and the G1b sign-off.
# TRAVEL_DATA_ENABLED=true
# TRAVEL_DATA_KEYS=t202701:<base64 of 32 random bytes – openssl rand -base64 32>

# --- Friends beta (APP_ENV=beta only, deployment.md §0.12.3) – values only in Vercel, never here ---
# Controller named in the beta privacy notice (2–100 characters). Not in the repository (public).
# LEGAL_OPERATOR_NAME=
# 1–5 beta codes, comma separated, first = current one (rotation); ≥ 12 letters/digits each.
# BETA_ACCESS_CODES=
# Maximum number of accounts (default 50, 1–500).
# BETA_MAX_ACCOUNTS=
# Kill switch of the invite way (variant B): false = invited people need the beta code too.
# BETA_INVITE_SIGNUP=
# «Feedback geben» (W23 D.2): WhatsApp number (digits only, e.g. 49151…) and/or mail address.
# FEEDBACK_WHATSAPP_NUMBER=
# FEEDBACK_EMAIL=
# Service worker kill switch (beta/production): false = /sw.js unregisters itself.
# PWA_SW_ENABLED=
