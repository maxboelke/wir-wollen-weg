# Copy to .env.local for local development: cp .env.example .env.local
# Names per docs/ops/deployment.md §4. Values below are local placeholders, NOT secrets.

# development (pnpm dev) · demo (docker/compose.demo.yml) · ci · staging · production
APP_ENV=development
APP_URL=http://localhost:3000

# Demo only (docker/compose.demo.yml): password of the demo database container
POSTGRES_PASSWORD=change-me-local-only

# PostgreSQL from docker/compose.dev.yml
DATABASE_URL=postgres://app:app@localhost:5432/wirwollenweg

# Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=

# Client IP for auth rate limits (R-005, docs/ops/deployment.md §0.1/§0.5/§5.2).
# The app must only be reachable through a proxy that OVERWRITES this header:
#   dev/ci/demo (Caddy in compose.demo.yml) + production (Caddy): x-forwarded-for
#   demo via Cloudflare tunnel: cf-connecting-ip (and DEMO_BIND_ADDRESS=127.0.0.1)
AUTH_IP_HEADER=x-forwarded-for
# Comma-separated IPs/CIDRs of proxies whose entries in the header are skipped (right to
# left). Empty = the rightmost entry is the client. Only for proxy chains, e.g. CDN → Caddy.
AUTH_TRUSTED_PROXIES=

# Demo only: host address for the published ports (proxy 3000, Mailpit 8025).
# 0.0.0.0 = LAN phone tests (trusted WLAN only), 127.0.0.1 = laptop only (café WLAN, tunnel)
DEMO_BIND_ADDRESS=0.0.0.0

# Mailpit from docker/compose.dev.yml (web UI: http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=login@mail.example.org
MAIL_FROM_NAME_DE="Wir wollen weg"
MAIL_FROM_NAME_EN="When do we go?"
MAIL_REPLY_TO=hallo@example.org
MAILPIT_API_URL=http://localhost:8025

# Phone tests with `pnpm dev -H 0.0.0.0`: comma-separated LAN hosts, e.g. 192.168.178.20
DEV_ALLOWED_ORIGINS=

LOG_LEVEL=debug
RATE_LIMIT_ENABLED=true
