{
  "name": "wir-wollen-weg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:services": "docker compose -f docker/compose.dev.yml up -d",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "node --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "demo:up": "docker compose -f docker/compose.demo.yml --env-file .env.demo up -d --build && pnpm demo:migrate",
    "demo:migrate": "docker compose -f docker/compose.demo.yml --env-file .env.demo run --rm tools pnpm db:migrate",
    "demo:seed": "docker compose -f docker/compose.demo.yml --env-file .env.demo run --rm tools pnpm db:seed:demo",
    "demo:down": "docker compose -f docker/compose.demo.yml --env-file .env.demo down",
    "demo:reset": "docker compose -f docker/compose.demo.yml --env-file .env.demo down -v"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3"
  }
}
