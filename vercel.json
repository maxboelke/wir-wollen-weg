{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm vercel-build",
  "ignoreCommand": "node scripts/vercel-ignore.ts",
  "crons": [{ "path": "/api/internal/retention", "schedule": "17 3 * * *" }],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "beta": true
    }
  }
}
